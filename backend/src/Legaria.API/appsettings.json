  "Authentication": {
    "RefreshTokenDays": 7,
    "MaximumFailedAttempts": 5,
    "LockoutMinutes": 15,
    "VerificationTokenHours": 24,
    "PasswordResetTokenMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
